---
import "../../styles/theme.css";
import HourStrip from "../components/HourStrip.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Player from "../components/Player.astro";
import NowPlaying from "../components/NowPlaying.astro";
import MemoryCard from "../components/MemoryCard.astro";
import Archive from "../components/Archive.astro";
---

<!doctype html>
<html lang="en" data-theme="diary">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A 24-hour fan radio station for Fred again..'s catalogue. Fan project, not affiliated." />
    <title>AGAIN RADIO</title>
    <link rel="preload" href="/fonts/instrument-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📻</text></svg>" />
  </head>
  <body class="min-h-screen flex flex-col text-[var(--fg)] bg-[var(--bg)]">

    <header class="flex items-center gap-4 px-5 py-3 border-b border-[var(--line)]">
      <div class="flex items-baseline gap-3 min-w-0">
        <span
          class="text-xl font-black tracking-tight text-[var(--fg)] shrink-0"
          style="font-family: var(--font-display);"
        >AGAIN RADIO</span>
        <span class="stamp hidden sm:block truncate">24 hours of a life in progress</span>
      </div>
      <div class="ml-auto shrink-0">
        <ThemeToggle data-blocks="[]" />
      </div>
    </header>

    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <div class="flex flex-col lg:flex-row flex-1 min-w-0">

        <section
          aria-label="Stage"
          class="relative flex-1 min-w-0 flex flex-col justify-center
                 border-b lg:border-b-0 lg:border-r border-[var(--line)]
                 px-5 py-8 lg:px-10 lg:py-10"
        >
          <canvas id="field" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
          <div class="stage-atmosphere" aria-hidden="true"></div>
          <div class="relative z-10">
            <Player />
          </div>
        </section>

        <aside
          aria-label="Now playing"
          class="w-full lg:w-[360px] shrink-0 flex flex-col gap-5
                 border-b lg:border-b-0 border-[var(--line)] px-5 py-6"
        >
          <NowPlaying />
          <MemoryCard />
        </aside>

      </div>

      <HourStrip data-blocks="[]" />
      <Archive />
    </main>

    <footer class="px-5 py-3 border-t border-[var(--line)]">
      <p class="stamp">
        Fan project. Not affiliated with Fred again.. All music &copy; its owners.
      </p>
    </footer>

    <script>
      import { loadStation } from "../lib/station.ts";
      import { startField } from "../canvas/field.ts";

      function applyHour(): void {
        const hour = new Date().getHours();
        document.querySelectorAll<HTMLElement>("[data-hour]").forEach((el) => {
          el.dataset.hour = String(hour);
        });
      }

      async function bootstrap(): Promise<void> {
        try {
          const station = await loadStation();
          const blocks = JSON.stringify(station.hourBlocks);
          document.querySelectorAll<HTMLElement>("[data-blocks]").forEach((el) => {
            el.dataset.blocks = blocks;
          });
        } catch {
          // leave components in their empty states
        }
        applyHour();
      }

      bootstrap();
      setInterval(applyHour, 60_000);

      const field = document.querySelector<HTMLCanvasElement>("#field");
      if (field) startField(field);
    </script>
  </body>
</html>
