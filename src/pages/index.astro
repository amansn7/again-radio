---
import "../../styles/theme.css";
import HourStrip from "../components/HourStrip.astro";
import Player from "../components/Player.astro";
import NowPlaying from "../components/NowPlaying.astro";
import MemoryCard from "../components/MemoryCard.astro";
import Tracklist from "../components/Tracklist.astro";
import LiveStatus from "../components/LiveStatus.astro";
import Search from "../components/Search.astro";
import Dial from "../components/Dial.astro";
import Archive from "../components/Archive.astro";
import OgMeta from "../components/OgMeta.astro";
---

<!doctype html>
<html lang="en" data-theme="sleek">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A 24-hour fan radio for Fred again..'s catalogue, where every track carries the memory it came from. Fan project, not affiliated." />
    <meta name="theme-color" content="#1c1815" />
    <title>Again Radio</title>
    <OgMeta title="again radio" description="A 24-hour fan radio for Fred again..'s catalogue, where every track carries the memory it came from." image="/og/default.jpg" path="/" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="preload" href="/fonts/instrument-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%231c1815'/><path d='M6 19c3-6 5-6 7 0s4 6 6 0 4-6 7 0' fill='none' stroke='%23f2eee6' stroke-width='2.2' stroke-linecap='round'/></svg>" />
  </head>
  <body class="min-h-[100dvh] flex flex-col">
    <div class="ambient" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="layer wrap topbar">
      <a class="wordmark" href="/" aria-label="Again Radio, home">again radio</a>
      <LiveStatus />
      <div class="topbar-end">
        <Search />
      </div>
    </header>

    <main id="main-content" class="flex-1 flex flex-col" tabindex="-1">
      <section class="layer wrap hero" aria-label="On air">
        <div class="hero-name">
          <NowPlaying />
          <MemoryCard />
        </div>
        <div class="hero-deck">
          <Player />
          <Tracklist />
          <HourStrip data-blocks="[]" />
        </div>
      </section>

      <div class="sheet">
        <Dial />
        <Archive />
      </div>
    </main>

    <footer class="sheet">
      <p class="wrap meta footer-line">
        Fan project. Not affiliated with Fred again.. All music &copy; its owners.
      </p>
    </footer>

    <style>
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 10;
        padding: 0.75rem 1rem;
        border-radius: var(--radius);
        color: var(--fg);
        background: var(--bg-2);
        transform: translateY(calc(-100% - 1rem));
      }
      .skip-link:focus { transform: none; }

      .topbar {
        z-index: 3;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        grid-template-areas: "mark live end";
        align-items: center;
        gap: 0.5rem 2rem;
        min-height: 4.5rem;
        padding-block: 0.75rem;
      }
      .topbar :global(live-status) { grid-area: live; }
      .wordmark {
        grid-area: mark;
        font-family: var(--font-name);
        font-weight: var(--name-weight);
        letter-spacing: var(--name-tracking);
        font-size: 1.375rem;
        line-height: 1;
        color: var(--fg);
        text-decoration: none;
        white-space: nowrap;
      }
      .topbar-end { grid-area: end; display: flex; align-items: center; gap: 0.75rem; }
      @media (max-width: 639px) {
        .topbar {
          grid-template-columns: minmax(0, 1fr) auto;
          grid-template-areas: "mark end" "live live";
          padding-block: 0.75rem 0.25rem;
        }
      }

      /* First screen: the video is the picture; the words sit low on it like captions on a
         projection, and the deck runs along the floor. */
      .hero {
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
        align-content: end;
        gap: clamp(2rem, 5vh, 3.5rem);
        min-height: calc(100dvh - 7rem);
        padding-block: 1.5rem 1.25rem;
      }
      .hero-name {
        align-self: end;
        min-width: 0;
        max-width: 58rem;
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 3.2vh, 2.25rem);
        text-shadow: 0 1px 18px var(--glass-drop);
      }
      .hero-deck { min-width: 0; display: flex; flex-direction: column; gap: 1.25rem; }
      @media (min-width: 1024px) {
        .hero { min-height: calc(100dvh - 4.5rem); padding-block: 2rem 1.5rem; }
        .hero-name { width: 62%; }
      }
      .footer-line { padding-block: 2.5rem; }
    </style>

    <script>
      import { loadStation } from "../lib/station.ts";
      import { startPalette } from "../lib/palette.ts";

      function applyHour(): void {
        const hour = String(new Date().getHours());
        document.querySelectorAll<HTMLElement>("[data-hour]").forEach((el) => {
          el.dataset.hour = hour;
        });
      }

      async function bootstrap(): Promise<void> {
        try {
          const station = await loadStation();
          const blocks = JSON.stringify(station.hourBlocks);
          document.querySelectorAll<HTMLElement>("[data-blocks]").forEach((el) => {
            el.dataset.blocks = blocks;
          });
        } catch {
          // components keep their own empty states
        }
        applyHour();
      }

      bootstrap();
      setInterval(applyHour, 60_000);

      startPalette();
    </script>
  </body>
</html>
