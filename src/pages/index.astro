---
import "../../styles/theme.css";
import HourStrip from "../components/HourStrip.astro";
import Player from "../components/Player.astro";
import NowPlaying from "../components/NowPlaying.astro";
import MemoryCard from "../components/MemoryCard.astro";
import Tracklist from "../components/Tracklist.astro";
import LiveStatus from "../components/LiveStatus.astro";
import Search from "../components/Search.astro";
import Dial from "../components/Dial.astro";
import Archive from "../components/Archive.astro";
import OgMeta from "../components/OgMeta.astro";
---

<!doctype html>
<html lang="en" data-theme="sleek">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A 24-hour fan radio for Fred again..'s catalogue, where every track carries the memory it came from. Fan project, not affiliated." />
    <meta name="theme-color" content="#1c1815" />
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://www.googlevideo.com" crossorigin />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="preconnect" href="https://is1-ssl.mzstatic.com" crossorigin />
    <title>Again Radio</title>
    <OgMeta title="again radio" description="A 24-hour fan radio for Fred again..'s catalogue, where every track carries the memory it came from." image="/og/default.jpg" path="/" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="preload" href="/fonts/instrument-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%231c1815'/><path d='M6 19c3-6 5-6 7 0s4 6 6 0 4-6 7 0' fill='none' stroke='%23f2eee6' stroke-width='2.2' stroke-linecap='round'/></svg>" />
  </head>
  <body class="min-h-[100dvh] flex flex-col">
    <div class="ambient" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="layer wrap topbar">
      <a class="wordmark" href="/" aria-label="Again Radio, home">again radio</a>
      <LiveStatus />
      <div class="topbar-end">
        <Search />
      </div>
    </header>

    <main id="main-content" class="flex-1 flex flex-col" tabindex="-1">
      <section class="layer wrap hero" aria-label="On air">
        <div class="hero-name">
          <NowPlaying />
          <MemoryCard />
        </div>
        <div class="hero-deck">
          <Player />
          <Tracklist />
          <HourStrip data-blocks="[]" />
        </div>
      </section>

      <div class="sheet">
        <Dial />
        <Archive />
      </div>
    </main>

    <footer class="sheet">
      <div class="wrap footer-line">
        <div class="footer-community">
          <p class="footer-heading">Find me around the radio</p>
          <details class="socials-disclosure">
            <summary class="footer-panel socials-toggle"><span>Socials and contact</span><span class="socials-mark" aria-hidden="true">+</span></summary>
            <nav class="footer-links" aria-label="Social and contact links">
              <div class="instagram-group">
                <div class="instagram-label"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="18" cy="6" r=".8" class="fill"/></svg><span>Instagram</span></div>
                <a href="https://www.instagram.com/islugabed/" target="_blank" rel="noreferrer" aria-label="Private Instagram account, @islugabed"><span>@islugabed</span><small><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/></svg>Private</small><b aria-hidden="true">↗</b></a>
                <a href="https://www.instagram.com/iamannihilation/" target="_blank" rel="noreferrer" aria-label="Public Instagram account, @iamannihilation"><span>@iamannihilation</span><small>Public</small><b aria-hidden="true">↗</b></a>
              </div>
              <a href="https://www.linkedin.com/in/slugabed" target="_blank" rel="noreferrer" aria-label="LinkedIn, slugabed" title="LinkedIn · slugabed"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9v10M5 5v.01M10 19v-6a4 4 0 0 1 8 0v6M10 10v9"/></svg></a>
              <a href="https://github.com/amansn7/again-radio" target="_blank" rel="noreferrer" aria-label="GitHub, again-radio" title="GitHub · again-radio"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1.2-4-2-5-2m10 4v-3.1a2.7 2.7 0 0 0-.8-2.1c2.7-.3 5.5-1.3 5.5-6A4.7 4.7 0 0 0 17.5 7a4.3 4.3 0 0 0-.1-3S16.4 3.7 14 5.3a12 12 0 0 0-6 0C5.6 3.7 4.6 4 4.6 4A4.3 4.3 0 0 0 4.5 7 4.7 4.7 0 0 0 3.3 10.8c0 4.7 2.8 5.7 5.5 6A2.7 2.7 0 0 0 8 18.9V21"/></svg></a>
              <a href="mailto:iamamansaini1@gmail.com" aria-label="Email Aman" title="Email · iamamansaini1@gmail.com"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg></a>
              <a href="https://wa.me/919041951331" target="_blank" rel="noreferrer" aria-label="WhatsApp, +91 90419 51331" title="WhatsApp · +91 90419 51331"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z"/><path d="M9 8.5c.4 2.5 2 4.1 4.5 4.5l1-1 2 1c-.4 2-2 2.5-3.5 2-3.5-1-5.5-3-6-6.5-.2-1.5.5-3 2.5-3.5l1 2Z"/></svg></a>
            </nav>
          </details>
        </div>
        <div class="footer-support">
          <p class="footer-heading">Keep the signal going</p>
          <div class="footer-panel footer-support-actions">
            <a href="upi://pay?pa=amansn7@oksbi&pn=Aman%20Saini&cu=INR" class="upi-link">
              <span>Buy me a coffee</span><small>UPI app</small>
            </a>
            <a class="paypal-qr" href="/images/paypal-qr.png" target="_blank" rel="noreferrer" aria-label="Open full-size PayPal QR code">
              <img src="/images/paypal-qr.png" alt="" loading="lazy" />
              <span>PayPal QR <small>Open to scan</small></span>
            </a>
          </div>
        </div>
        <p class="meta footer-disclaimer">Fan project. Not affiliated with Fred again.. All music &copy; its owners.</p>
      </div>
    </footer>

    <style>
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 10;
        padding: 0.75rem 1rem;
        border-radius: var(--radius);
        color: var(--fg);
        background: var(--bg-2);
        transform: translateY(calc(-100% - 1rem));
      }
      .skip-link:focus { transform: none; }

      .topbar {
        z-index: 3;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        grid-template-areas: "mark live end";
        align-items: center;
        gap: 0.5rem 2rem;
        min-height: 4.5rem;
        padding-block: 0.75rem;
      }
      .topbar :global(live-status) { grid-area: live; }
      .wordmark {
        grid-area: mark;
        font-family: var(--font-name);
        font-weight: var(--name-weight);
        letter-spacing: var(--name-tracking);
        font-size: 1.375rem;
        line-height: 1;
        color: var(--fg);
        text-decoration: none;
        white-space: nowrap;
      }
      .topbar-end { grid-area: end; display: flex; align-items: center; gap: 0.75rem; }
      @media (max-width: 639px) {
        .topbar {
          grid-template-columns: minmax(0, 1fr) auto;
          grid-template-areas: "mark end" "live live";
          padding-block: 0.75rem 0.25rem;
        }
      }

      /* First screen: the video is the picture; the words sit low on it like captions on a
         projection, and the deck runs along the floor. */
      .hero {
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
        align-content: end;
        gap: clamp(2rem, 5vh, 3.5rem);
        min-height: calc(100dvh - 7rem);
        padding-block: 1.5rem 1.25rem;
      }
      .hero-name {
        align-self: end;
        min-width: 0;
        max-width: 58rem;
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 3.2vh, 2.25rem);
        text-shadow: 0 1px 18px var(--glass-drop);
      }
      .hero-deck { min-width: 0; display: flex; flex-direction: column; gap: 1.25rem; }
      @media (min-width: 1024px) {
        .hero { min-height: calc(100dvh - 4.5rem); padding-block: 2rem 1.5rem; }
        .hero-name { width: 62%; }
      }
      .footer-line { padding-block: 2.5rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 3rem; }
      .footer-community, .footer-support { min-width: 0; }
      .footer-heading { min-height: 1em; margin: 0 0 0.8rem; color: var(--fg-faint); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; }
      .footer-panel { box-sizing: border-box; width: 100%; height: 3.75rem; min-height: 3.75rem; border: 1px solid var(--line); border-radius: 1rem; background: color-mix(in oklab, var(--card) 55%, transparent); }
      .socials-toggle { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 0.5rem 0.85rem; color: var(--fg-dim); font-size: 0.8125rem; cursor: pointer; list-style: none; transition: color var(--dur-1), border-color var(--dur-1), background var(--dur-1); }
      .socials-toggle::-webkit-details-marker { display: none; }
      .socials-toggle:hover { color: var(--fg); border-color: color-mix(in oklab, var(--accent) 45%, var(--line)); background: var(--card); }
      .socials-mark { color: var(--accent); font-size: 1rem; transition: transform var(--dur-1) var(--ease-out); }
      .socials-disclosure[open] .socials-mark { transform: rotate(45deg); }
      .footer-links { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-top: 0.65rem; }
      .footer-links a, .upi-link, .paypal-qr { min-height: 2.75rem; padding: 0.45rem 0.75rem; border: 1px solid var(--line); border-radius: 0.75rem; background: color-mix(in oklab, var(--card) 55%, transparent); color: var(--fg-dim); text-decoration: none; transition: transform var(--dur-1) var(--ease-out), border-color var(--dur-1), color var(--dur-1), background var(--dur-1); }
      .footer-links a { display: flex; align-items: center; justify-content: center; width: 2.75rem; padding-inline: 0.45rem; }
      .footer-links svg { width: 1.2rem; height: 1.2rem; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
      .footer-links svg .fill { fill: currentColor; stroke: none; }
      .instagram-group { display: grid; gap: 0.2rem; min-width: 13rem; padding: 0.4rem 0.55rem; border: 1px solid var(--line); border-radius: 0.9rem; background: color-mix(in oklab, var(--card) 55%, transparent); }
      .instagram-label { display: flex; align-items: center; gap: 0.4rem; padding: 0.1rem 0.35rem 0.3rem; color: var(--fg-faint); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; }
      .instagram-label svg { width: 0.9rem; height: 0.9rem; fill: none; stroke: currentColor; stroke-width: 1.7; }
      .instagram-label .fill { fill: currentColor; stroke: none; }
      .footer-links .instagram-group a { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 0.55rem; width: auto; min-height: 2rem; padding: 0.25rem 0.35rem; border: 0; border-radius: 0.45rem; background: transparent; font-size: 0.8125rem; }
      .instagram-group a small { display: flex; align-items: center; gap: 0.2rem; font-size: 0.625rem; }
      .instagram-group a small svg { width: 0.75rem; height: 0.75rem; fill: none; stroke: currentColor; stroke-width: 1.5; }
      .instagram-group a b { color: var(--fg-faint); font-size: 0.75rem; font-weight: 400; }
      .footer-links .instagram-group a:hover { transform: none; color: var(--fg); background: color-mix(in oklab, var(--fg) 6%, transparent); }
      .footer-links small, .upi-link small, .paypal-qr small { color: var(--fg-faint); font-size: 0.75rem; }
      .footer-links a:hover, .upi-link:hover, .paypal-qr:hover { transform: translateY(-2px); border-color: color-mix(in oklab, var(--accent) 45%, var(--line)); color: var(--fg); background: var(--card); }
      .footer-support-actions { display: flex; align-items: center; gap: 0.35rem; padding: 0.25rem; }
      .footer-support-actions .upi-link, .footer-support-actions .paypal-qr { border-color: transparent; background: transparent; }
      .footer-support-actions .upi-link, .footer-support-actions .paypal-qr { height: 100%; min-height: 0; padding-block: 0.25rem; line-height: 1.15; }
      .upi-link { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 0.1rem; }
      .paypal-qr { display: flex; align-items: center; gap: 0.6rem; font-size: 0.8125rem; }
      .paypal-qr img { width: 2rem; height: 2rem; border-radius: 4px; opacity: 0.78; transition: opacity var(--dur-1); }
      .paypal-qr:hover img, .paypal-qr:focus-visible img { opacity: 1; }
      .paypal-qr span { display: flex; flex-direction: column; }
      .footer-support-actions small { line-height: 1.1; }
      .footer-disclaimer { grid-column: 1 / -1; margin: 0; padding-top: 1rem; border-top: 1px solid var(--line); }
      @media (max-width: 639px) {
        .footer-line { grid-template-columns: 1fr; gap: 1.5rem; }
        .footer-disclaimer { grid-column: auto; }
        .footer-links { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.45rem; }
        .footer-links .instagram-group { grid-column: 1 / -1; min-width: 0; }
        .footer-links > a { width: 100%; }
      }
      @media (max-width: 380px) {
        .footer-support-actions { gap: 0.1rem; }
        .footer-support-actions .upi-link, .footer-support-actions .paypal-qr { padding-inline: 0.5rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        .socials-toggle, .socials-mark, .footer-links a, .upi-link, .paypal-qr, .paypal-qr img { transition: none; }
      }
    </style>

    <script>
      import { loadStation } from "../lib/station.ts";
      import { startPalette } from "../lib/palette.ts";

      function applyHour(): void {
        const hour = String(new Date().getHours());
        document.querySelectorAll<HTMLElement>("[data-hour]").forEach((el) => {
          el.dataset.hour = hour;
        });
      }

      async function bootstrap(): Promise<void> {
        try {
          const station = await loadStation();
          const blocks = JSON.stringify(station.hourBlocks);
          document.querySelectorAll<HTMLElement>("[data-blocks]").forEach((el) => {
            el.dataset.blocks = blocks;
          });
        } catch {
          // components keep their own empty states
        }
        applyHour();
      }

      bootstrap();
      setInterval(applyHour, 60_000);

      startPalette();
    </script>
  </body>
</html>
