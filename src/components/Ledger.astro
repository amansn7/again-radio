---
---

<section class="wrap lg-section" aria-labelledby="lg-title">
  <life-ledger></life-ledger>
</section>

<style is:global>
  .lg-section { padding-block: clamp(4rem, 8vw, 7rem) 0; }
  life-ledger { display: block; position: relative; }
  .lg-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem; margin-bottom: 2.5rem; }
  .lg-skel { height: 22rem; }
  .lg-error { max-width: 36rem; }

  .lg-scroll { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; padding: 8px; margin: -8px; }
  .lg-scroll::-webkit-scrollbar { display: none; }
  @media (max-width: 1199px) {
    .lg-scroll {
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);
    }
  }
  .lg-stage { position: relative; min-width: 1100px; }

  .lg-bands, .lg-axis, .lg-years, .lg-names { position: relative; }
  .lg-axis { height: 28px; }
  .lg-years { height: 24px; }

  .lg-it {
    position: absolute; padding: 0; border: 0; background: none; font: inherit; cursor: pointer;
    color: var(--fg-dim); transition: color var(--dur-2) var(--ease-out);
  }
  life-ledger.has-on .lg-it { color: var(--fg-faint); }
  life-ledger.has-on .lg-it.is-on { color: var(--fg); }
  .lg-it:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }

  .lg-band, .lg-mark { top: calc(var(--lane) * 44px); height: 44px; }
  .lg-band { width: var(--w); min-width: 3px; }
  .lg-mark { width: 12px; margin-left: -6px; }
  .lg-band::before, .lg-mark::before {
    content: ""; position: absolute; transform-origin: left; background: color-mix(in oklab, currentColor 55%, transparent);
    transition: background-color var(--dur-2) var(--ease-out);
  }
  .lg-band::before { left: 0; right: 0; top: 30px; height: 5px; border-radius: 1px; }
  .lg-mark::before { left: 5px; width: 2px; top: 24px; height: 18px; }
  .lg-label {
    position: absolute; left: 0; top: 2px; white-space: nowrap; pointer-events: none;
    font-family: var(--font-name); font-weight: var(--name-weight); letter-spacing: var(--name-tracking);
    font-size: 1.0625rem; line-height: 22px;
  }
  .lg-mark .lg-label { left: 6px; }
  .lg-band.is-flip .lg-label { left: auto; right: 0; }
  .lg-mark.is-flip .lg-label { left: auto; right: 6px; }
  .lg-band:focus-visible, .lg-mark:focus-visible { outline: 0; }
  .lg-band:focus-visible .lg-label, .lg-mark:focus-visible .lg-label { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }

  .lg-axisline { position: absolute; inset: 20px 0 auto 0; height: 1px; transform-origin: left; background: color-mix(in oklab, var(--fg) 40%, transparent); }
  .lg-tick { top: 4px; width: 9px; height: 16px; margin-left: -4px; }
  .lg-tick::before { content: ""; position: absolute; left: 4px; bottom: 0; width: 1px; height: 9px; background: currentColor; }

  .lg-year {
    position: absolute; top: 0; padding: 3px 0 0 6px; border-left: 1px solid var(--line);
    font-size: 0.8125rem; line-height: 18px; color: var(--fg-faint);
  }

  .lg-name {
    top: calc(var(--row) * 28px + 12px); height: 28px; display: flex; align-items: center; gap: 0.45rem;
    white-space: nowrap; font-family: var(--font-name); font-weight: var(--name-weight);
    letter-spacing: var(--name-tracking); font-size: 1rem; line-height: 1; padding-right: 0.25rem;
  }
  .lg-name::before { content: ""; width: 4px; height: 4px; border-radius: 50%; background: currentColor; flex: none; }
  .lg-name.is-flip { translate: -100% 0; flex-direction: row-reverse; padding: 0 0 0 0.25rem; }

  :root[data-theme="sleek"] .lg-band::before { background: color-mix(in oklab, var(--accent) 38%, transparent); box-shadow: 0 0 14px color-mix(in oklab, var(--accent) 40%, transparent); }
  :root[data-theme="sleek"] .lg-mark::before { background: color-mix(in oklab, var(--accent) 60%, transparent); }
  :root[data-theme="sleek"] .lg-it.is-on.lg-band::before, :root[data-theme="sleek"] .lg-it.is-on.lg-mark::before { background: var(--accent); }
  :root[data-theme="sleek"] .lg-axisline { background: color-mix(in oklab, var(--accent) 45%, transparent); box-shadow: 0 0 10px color-mix(in oklab, var(--accent) 35%, transparent); }
  :root[data-theme="sleek"] .lg-name.is-on { text-shadow: 0 0 16px color-mix(in oklab, var(--accent) 55%, transparent); }

  .lg-card {
    position: absolute; z-index: 5; left: 0; top: 0; display: flex; gap: 0.9rem; width: min(19rem, calc(100% - 1rem));
    padding: 0.9rem; color: var(--card-fg); background: var(--card); border-radius: var(--radius); box-shadow: var(--frame-shadow);
    pointer-events: none; opacity: 0; transform: translateY(4px);
    transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }
  .lg-card.is-show { opacity: 1; transform: none; }
  .lg-card img {
    flex: none; width: 72px; height: 72px; border-radius: var(--radius); object-fit: cover; opacity: 0;
    background: color-mix(in oklab, var(--card-fg) 10%, transparent); transition: opacity var(--dur-2) var(--ease-out);
  }
  .lg-card img.is-loaded { opacity: 1; }
  .lg-card.no-art img { display: none; }
  .lg-card-body { min-width: 0; display: grid; gap: 0.2rem; align-content: start; }
  .lg-card-body p { margin: 0; }
  .lg-card-title { font-family: var(--font-name); font-weight: var(--name-weight); letter-spacing: var(--name-tracking); font-size: 1.25rem; line-height: 1.15; }
  .lg-card .meta { color: color-mix(in oklab, var(--card-fg) 68%, transparent); }
  .lg-card-songs { display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; margin-top: 0.3rem !important; line-height: 1.45; }
  .lg-card-songs b { font-weight: 600; color: var(--card-fg); }
  :root[data-theme="sleek"] .lg-card { background: color-mix(in oklab, var(--bg-2) 86%, var(--fg)); border: 1px solid var(--line); backdrop-filter: blur(16px); }

  .lg-stage[data-reveal="pending"] :is(.lg-it, .lg-year, .lg-axisline) { opacity: 0; }
  .lg-stage[data-reveal="done"] .lg-axisline { animation: lg-draw 1.2s var(--ease-out) backwards; }
  .lg-stage[data-reveal="done"] .lg-year { animation: lg-fade 700ms var(--ease-out) backwards; animation-delay: 400ms; }
  .lg-stage[data-reveal="done"] .lg-it { animation: lg-fade 700ms var(--ease-out) backwards; animation-delay: var(--d); }
  .lg-stage[data-reveal="done"] .lg-band::before { animation: lg-draw 1.2s var(--ease-out) backwards; animation-delay: var(--d); }
  @keyframes lg-draw { from { transform: scaleX(0); } }
  @keyframes lg-fade { from { opacity: 0; } }

  @media (max-width: 767px) {
    .lg-head { margin-bottom: 1.75rem; }
  }
</style>

<script>
  import "./ledger.ts";
</script>
