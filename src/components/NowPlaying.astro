---
const { ...attrs } = Astro.props;
---
<now-playing {...attrs}>
  <div class="np-fit">
    <div class="np-skel" aria-hidden="true"><i class="skeleton"></i><i class="skeleton"></i></div>
    <h2 class="np-name" aria-live="polite"></h2>
    <p class="np-rest"></p>
  </div>
  <div class="np-meta glass">
    <span class="np-cover skeleton" aria-hidden="true"></span>
    <span class="np-meta-text">
      <span class="np-album"></span>
      <span class="np-when">
        <span class="np-stamp stamp"></span>
        <span class="np-plain meta num"></span>
      </span>
    </span>
  </div>
</now-playing>

<style is:global>
  now-playing { display: contents; }

  .np-fit {
    --glyph: 0.46;
    container-type: inline-size;
    width: 100%;
    min-width: 0;
  }
  :root[data-theme="sleek"] .np-fit { --glyph: 0.6; }

  .np-skel { display: flex; flex-direction: column; gap: 0.9rem; }
  .np-skel i:first-child { height: clamp(3.25rem, 7vw, 6.5rem); width: 72%; }
  .np-skel i:last-child { height: 1.5rem; width: 38%; }
  .np-fit[data-ready] .np-skel { display: none; }
  .np-fit:not([data-ready]) .np-name,
  .np-fit:not([data-ready]) .np-rest { display: none; }

  .np-name {
    position: relative;
    display: flex;
    align-items: flex-end;
    margin: 0;
    min-height: 1.84em;
    font-family: var(--font-name);
    font-weight: var(--name-weight);
    letter-spacing: var(--name-tracking);
    line-height: 0.92;
    color: var(--fg);
    font-size: min(
      clamp(3.25rem, 7vw, 7.25rem),
      calc(100cqi / (var(--len, 5) * var(--glyph)))
    );
  }
  .np-name .w { display: inline-block; white-space: nowrap; }
  /* Glass letters: the video shows through, the rim holds the shape, the top edge catches
     light on every beat (--beat is written per frame by now-playing.ts). */
  /* The rim is a tight halo, not text-stroke: stroke exposes the variable font's overlapping contours. */
  .np-name-in {
    filter:
      drop-shadow(0 0 0.6px color-mix(in oklab, var(--glass-light) calc(55% + var(--beat, 0) * 45%), transparent))
      drop-shadow(0 14px 36px var(--glass-drop));
  }
  .np-name .l {
    display: inline-block;
    color: transparent;
    background-image: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--glass-light) calc(78% + var(--beat, 0) * 22%), transparent) 0%,
      color-mix(in oklab, var(--glass-light) calc(30% + var(--beat, 0) * 25%), transparent) 22%,
      color-mix(in oklab, var(--glass-light) 9%, transparent) 50%,
      color-mix(in oklab, var(--glass-light) 12%, transparent) 78%,
      color-mix(in oklab, var(--glass-light) 46%, transparent) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    animation: arrive 700ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 28ms);
  }

  .np-rest {
    margin: 0.75rem 0 0;
    min-height: 1.5em;
    color: var(--fg);
    text-shadow: 0 1px 14px var(--glass-drop);
  }
  :root[data-theme="sleek"] .np-rest {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.375rem;
    line-height: 1.25;
  }
  .np-rest-in { display: inline-block; }
  :root[data-theme="sleek"] .np-rest-in { animation: arrive 700ms var(--ease-out) 250ms both; }

  .np-meta {
    order: 2;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    width: fit-content;
    max-width: 100%;
    min-height: 44px;
    padding: 6px 1.25rem 6px 6px;
    border-radius: 999px;
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .np-meta[data-empty] { visibility: hidden; }
  .np-cover {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--line);
  }
  .np-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .np-meta-text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .np-album {
    color: var(--fg);
    font-size: 0.9375rem;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .np-when { display: flex; min-height: 1.3rem; align-items: center; }
  :root[data-theme="sleek"] .np-stamp { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .np-name .l, .np-rest-in { animation-delay: 0s !important; }
  }
</style>

<script>
  import "./now-playing.ts";
</script>
