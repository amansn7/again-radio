---
const { ...attrs } = Astro.props;
---
<now-playing {...attrs}>
  <div class="np-fit">
    <div class="np-skel" aria-hidden="true"><i class="skeleton"></i><i class="skeleton"></i></div>
    <h2 class="np-name" aria-live="polite"></h2>
    <p class="np-rest"></p>
  </div>
  <div class="np-meta">
    <span class="np-cover skeleton" aria-hidden="true"></span>
    <span class="np-meta-text">
      <span class="np-album"></span>
      <span class="np-plain num"></span>
      <span class="np-stamp" hidden></span>
    </span>
  </div>
</now-playing>

<style is:global>
  now-playing { display: contents; }

  .np-fit {
    --glyph: 0.6;
    container-type: inline-size;
    width: 100%;
    min-width: 0;
  }

  .np-skel { display: flex; flex-direction: column; gap: 0.9rem; }
  .np-skel i:first-child { height: clamp(3.25rem, 7vw, 6.5rem); width: 72%; }
  .np-skel i:last-child { height: 1.75rem; width: 34%; }
  .np-fit[data-ready] .np-skel { display: none; }
  .np-fit:not([data-ready]) .np-name,
  .np-fit:not([data-ready]) .np-rest { display: none; }

  /* Fits the longest word in the column, and the whole name in two lines. */
  .np-name {
    --sx: 0.5;
    --kick: 0;
    --nw: 0px;
    --nh: 0px;
    position: relative;
    display: flex;
    align-items: flex-end;
    margin: 0;
    min-height: 1.8em;
    font-family: var(--font-name);
    font-weight: var(--name-weight);
    letter-spacing: var(--name-tracking);
    line-height: 1.08;
    color: var(--fg);
    font-size: min(
      clamp(3.25rem, 8vw, 8.5rem),
      calc(100cqi / (var(--len, 5) * var(--glyph))),
      calc(200cqi / (var(--total, 10) * var(--glyph) * 1.04))
    );
  }
  .np-name .w { display: inline-block; white-space: nowrap; }

  /* Glass letters: mostly clear so the video shows through, a lit rim, and one stage light
     (--sx, --kick from hero-name.ts) shared across the whole word. The rim is a tight halo,
     not text-stroke: stroke exposes the variable font's overlapping contours. */
  .np-name-in {
    filter:
      drop-shadow(0 0 0.6px color-mix(in oklab, var(--glass-light) calc(60% + var(--kick) * 40%), transparent))
      drop-shadow(0 12px 32px var(--glass-drop));
    transition: filter 180ms var(--ease-out);
  }
  .np-name .l {
    display: inline-block;
    padding-block: 0.18em;
    margin-block: -0.09em;
    color: transparent;
    background-image:
      radial-gradient(
        calc(var(--nw) * 0.3) calc(var(--nh) * 1.1) at calc(var(--sx) * var(--nw)) 35%,
        color-mix(in oklab, var(--glass-light) calc(44% + var(--kick) * 24%), transparent),
        transparent
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklab, var(--glass-light) 96%, transparent) 0%,
        color-mix(in oklab, var(--glass-light) 68%, transparent) 20%,
        color-mix(in oklab, var(--glass-light) 42%, transparent) 52%,
        color-mix(in oklab, var(--glass-light) 44%, transparent) 80%,
        color-mix(in oklab, var(--glass-light) 76%, transparent) 100%
      );
    background-size: var(--nw) var(--nh), 100% 100%;
    background-position: calc(var(--x, 0px) * -1) calc(var(--y, 0px) * -1), 0 0;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    translate: 0 calc(var(--kick) * max(0, 1 - 3 * max(var(--cx, 0) - var(--sx), var(--sx) - var(--cx, 0))) * -0.025em);
    animation: np-in 680ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 18ms);
  }
  .np-name-in.np-out,
  .np-rest-in.np-out { animation: np-out 220ms var(--ease-in-out) forwards; }

  .np-rest {
    margin: 0.55rem 0 0;
    min-height: 1.15em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    line-height: 1.15;
    color: color-mix(in oklab, var(--fg) 88%, transparent);
    text-shadow: 0 1px 2px var(--glass-drop), 0 2px 24px var(--glass-drop);
  }
  .np-rest-in { display: inline-block; animation: np-rest-in 600ms var(--ease-out) 160ms both; }

  .np-meta {
    order: 2;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    min-height: 40px;
    transform: translateY(0);
    transition: opacity 240ms var(--ease-out), transform 240ms var(--ease-out);
  }
  .np-meta[data-changing] { opacity: 0.35; transform: translateY(2px); }
  .np-meta[data-empty] { visibility: hidden; }
  .np-cover {
    position: relative;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--line);
    box-shadow: 0 0 0 1px var(--line), 0 8px 20px var(--glass-drop);
  }
  .np-cover img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  .np-cover img.np-cover-in { animation: np-cover-in 360ms var(--ease-out) both; }
  .np-meta-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-size: 0.875rem;
    line-height: 1.35;
    text-shadow: 0 1px 12px var(--glass-drop);
  }
  .np-album { color: var(--fg); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .np-plain { color: var(--fg-dim); }

  @keyframes np-in {
    from { opacity: 0; filter: blur(0.06em); transform: translateY(0.12em) scale(1.015); }
    to { opacity: 1; filter: blur(0); transform: none; }
  }
  @keyframes np-out {
    to { opacity: 0; filter: blur(5px); transform: translateY(-0.08em); }
  }
  @keyframes np-rest-in {
    from { opacity: 0; filter: blur(2px); transform: translateY(0.12em); }
    to { opacity: 1; filter: blur(0); transform: none; }
  }
  @keyframes np-cover-in { from { opacity: 0; } to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .np-name .l, .np-rest-in, .np-cover img.np-cover-in { animation: none !important; }
    .np-name .l { filter: none; transform: none; translate: none; }
    .np-name-in { filter: none; }
    .np-meta { transition: none; }
  }
</style>

<script>
  import "./now-playing.ts";
</script>
