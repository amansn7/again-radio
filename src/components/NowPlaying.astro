---
const { ...attrs } = Astro.props;
---
<now-playing {...attrs}></now-playing>

<style is:global>
  now-playing { display: flex; flex-direction: column; width: 100%; }

  .np-artwork-box {
    aspect-ratio: 1 / 1;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-2);
    flex-shrink: 0;
  }
  .np-artwork-box img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .np-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-size: 2rem; font-weight: 700;
    color: var(--fg-dim); letter-spacing: -0.02em;
  }
  .np-placeholder.is-stamp {
    font-family: var(--font-mono); font-size: 0.625rem; font-weight: 400;
    letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.6;
  }
  .np-ident {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--fg-dim);
  }

  .np-track-area { display: grid; margin-top: 0.75rem; }
  .np-track-area > * { grid-area: 1 / 1; }

  .np-empty-state {
    display: flex; flex-direction: column; justify-content: center; gap: 0.5rem;
    transition: opacity 200ms ease;
  }
  .np-empty-state.is-gone { opacity: 0; }

  .np-fields { transition: opacity 200ms ease; opacity: 0; }
  .np-fields.is-live { opacity: 1; }

  .np-title-wrap { min-height: 3.4rem; display: flex; align-items: flex-start; }
  .np-title {
    font-family: var(--font-display); font-size: 1.375rem; font-weight: 700;
    letter-spacing: -0.02em; line-height: 1.2; color: var(--fg); word-break: break-word;
  }
  .np-artist-wrap { min-height: 1.5rem; margin-top: 0.25rem; }
  .np-artist { font-family: var(--font-body); font-size: 0.9375rem; color: var(--fg-dim); }
  .np-album-wrap { min-height: 1.25rem; margin-top: 0.375rem; }
  .np-album {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--fg-dim);
  }
  .np-programme {
    margin-top: 0.5rem; display: flex; align-items: center; gap: 0.375rem;
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--fg-dim); min-height: 1.25rem;
  }
  .np-state-dot { flex-shrink: 0; color: var(--accent); }
  .np-progress-wrap { margin-top: 0.75rem; min-height: 2rem; }
  .np-progress-track { width: 100%; height: 1px; background: var(--line); position: relative; overflow: hidden; }
  .np-progress-fill { position: absolute; left: 0; top: 0; height: 100%; background: var(--accent); width: 0%; }
  .np-progress-times {
    display: flex; justify-content: space-between; margin-top: 0.3rem;
    font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--fg-dim);
  }

</style>

<script>
  import "./now-playing.ts";
</script>
