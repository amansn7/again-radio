---
const { ...attrs } = Astro.props;
---
<live-status {...attrs}></live-status>

<style is:global>
  /* The on-air sign: is it live, how far into the set everyone is, who else is here. */
  live-status {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    white-space: nowrap;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--fg-dim);
    text-shadow: 0 1px 10px var(--glass-drop);
  }
  live-status > span + span::before {
    content: "";
    display: inline-block;
    width: 1px;
    height: 0.85em;
    margin-right: 0.75rem;
    vertical-align: -0.1em;
    background: var(--line);
  }
  live-status [hidden] { display: none !important; }
  live-status .ls-sign { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--fg); font-weight: 500; }
  live-status .live-dot { box-shadow: 0 0 10px var(--accent); }
  live-status .ls-hollow { width: 0.5rem; height: 0.5rem; border-radius: 50%; border: 1px solid var(--fg-dim); }
  live-status:not(.is-live) .ls-sign { color: var(--fg-dim); font-weight: 400; }
  live-status .ls-clock { color: var(--fg); overflow: hidden; text-overflow: ellipsis; }
  live-status .ls-short { display: none; }
  live-status .ls-go {
    min-width: 44px; min-height: 44px; font: inherit; color: var(--accent); background: none; border: 0; padding: 0.25rem; margin: -0.25rem 0 -0.25rem 0.25rem;
    cursor: pointer; text-decoration: underline; text-underline-offset: 3px;
    transition: transform var(--dur-1) var(--ease-out), color var(--dur-2) var(--ease-out);
  }
  live-status .ls-go:hover { color: var(--fg); }
  live-status .ls-go:active { transform: scale(0.97); }
  live-status .ls-n { display: inline-flex; overflow: hidden; color: var(--fg); }
  live-status .ls-d.roll { animation: ls-roll var(--dur-2) var(--ease-out); }
  @keyframes ls-roll { from { transform: translateY(100%); opacity: 0; } to { transform: none; opacity: 1; } }
  live-status .ls-scheduled {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.625rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 14%, transparent);
    border: 1px solid color-mix(in oklab, var(--accent) 32%, transparent);
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: background var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out);
  }
  live-status .ls-scheduled:hover {
    background: color-mix(in oklab, var(--accent) 24%, transparent);
    transform: translateY(-1px);
  }
  live-status .ls-scheduled:active {
    transform: translateY(0);
  }
  live-status .ls-scheduled[hidden] {
    display: none !important;
  }
  live-status .ls-sched-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: ls-sched-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes ls-sched-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.85); }
  }
  @media (max-width: 479px) { live-status .ls-long { display: none; } live-status .ls-short { display: inline; } }
</style>

<script>
  import "./live-status.ts";
</script>
