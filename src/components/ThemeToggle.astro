---
const { ...attrs } = Astro.props;
---
<theme-toggle {...attrs}></theme-toggle>

<style is:global>
  theme-toggle { display: inline-flex; align-items: center; gap: 0.75rem; }
  .tt-group { position: relative; display: inline-flex; align-items: stretch; height: 2.25rem; box-sizing: border-box; padding: 0 3px; border: 1px solid var(--line); border-radius: 999px; background: color-mix(in oklab, var(--fg) 5%, transparent); }
  .tt-ind { position: absolute; top: 3px; bottom: 3px; left: 0; width: 0; border-radius: 999px; background: var(--card); }
  .tt-group.is-ready .tt-ind { transition: transform var(--dur-2) var(--ease-out), width var(--dur-2) var(--ease-out); }
  .tt-btn { position: relative; z-index: 1; padding: 0 1rem; font: 500 0.875rem/1 var(--font-body); color: var(--fg-dim); background: transparent; border: 0; border-radius: 999px; cursor: pointer; transition: color var(--dur-2) var(--ease-out), transform var(--dur-1) var(--ease-out); }
  .tt-btn[aria-checked="true"] { color: var(--fg); }
  .tt-btn:hover { color: var(--fg); }
  .tt-btn:active { transform: scale(0.97); }
  .tt-caption { white-space: nowrap; }
  :root[data-theme="diary"] .tt-ind { box-shadow: 0 1px 2px color-mix(in oklab, var(--fg) 14%, transparent); }
  :root[data-theme="sleek"] .tt-ind { box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--fg) 10%, transparent); }
  @media (max-width: 639px) { .tt-caption { display: none; } }
  @media (prefers-reduced-motion: reduce) { .tt-btn, .tt-group.is-ready .tt-ind { transition: none; } }
</style>

<script>
  import { readStoredChoice, writeStoredChoice, seededAutoTheme, blockForHour } from "../lib/theme.ts";
  import type { ThemeChoice } from "../lib/theme.ts";
  import type { HourBlock, ThemeName } from "../lib/station.ts";

  const OPTIONS: ThemeChoice[] = ["auto", "diary", "sleek"];
  const LABELS: Record<ThemeChoice, string> = { auto: "Auto", diary: "Diary", sleek: "Rave" };

  function pad(n: number): string { return String(n).padStart(2, "0"); }
  function todayKey(): string { const d = new Date(); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; }
  function store(): Storage | undefined { return typeof localStorage !== "undefined" ? localStorage : undefined; }

  function parseBlocks(raw: string | null): HourBlock[] {
    if (!raw) return [];
    try {
      const parsed: unknown = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((b): b is HourBlock =>
        typeof b === "object" && b !== null &&
        typeof (b as Record<string, unknown>).from === "number" &&
        typeof (b as Record<string, unknown>).to === "number" &&
        typeof (b as Record<string, unknown>).label === "string" &&
        ((b as Record<string, unknown>).theme === "diary" || (b as Record<string, unknown>).theme === "sleek")
      );
    } catch { return []; }
  }

  class ThemeToggle extends HTMLElement {
    static observedAttributes = ["data-blocks", "data-hour"];
    private _choice: ThemeChoice = "auto";

    connectedCallback(): void {
      this._choice = readStoredChoice(store());
      this._render();
      this._applyTheme();
      this._moveIndicator();
      requestAnimationFrame(() => {
        document.documentElement.classList.add("theme-live");
        this.querySelector(".tt-group")?.classList.add("is-ready");
      });
      document.fonts.ready.then(() => this._moveIndicator());
    }

    attributeChangedCallback(): void {
      if (this._choice === "auto") this._applyTheme();
      this._updateButtons();
    }

    private _blocks(): HourBlock[] { return parseBlocks(this.getAttribute("data-blocks")); }
    private _hour(): number {
      const raw = this.getAttribute("data-hour");
      return raw !== null && /^\d+$/.test(raw) ? parseInt(raw, 10) % 24 : new Date().getHours();
    }

    private _applyTheme(): void {
      const blocks = this._blocks();
      const hour = this._hour();
      let resolved: ThemeName;
      if (this._choice === "auto") {
        resolved = blocks.length ? seededAutoTheme(blocks, hour, todayKey()) : "diary";
      } else {
        resolved = this._choice;
      }
      document.documentElement.dataset.theme = resolved;
      this._updateCaption(resolved, blocks, hour);
    }

    private _updateCaption(resolved: ThemeName, blocks: HourBlock[], hour: number): void {
      const caption = this.querySelector<HTMLElement>(".tt-caption");
      if (!caption) return;
      caption.hidden = this._choice !== "auto" || !blocks.length;
      if (!caption.hidden) caption.textContent = `${LABELS[resolved]} until ${pad(blockForHour(blocks, hour).to % 24)}:00`;
    }

    private _select(choice: ThemeChoice): void {
      this._choice = choice;
      writeStoredChoice(store(), choice);
      this._applyTheme();
      this._updateButtons();
    }

    private _updateButtons(): void {
      this.querySelectorAll<HTMLButtonElement>(".tt-btn").forEach(btn => {
        const checked = btn.dataset.choice === this._choice;
        btn.setAttribute("aria-checked", String(checked));
        btn.tabIndex = checked ? 0 : -1;
      });
      this._moveIndicator();
    }

    private _moveIndicator(): void {
      const active = this.querySelector<HTMLButtonElement>('.tt-btn[aria-checked="true"]');
      const ind = this.querySelector<HTMLElement>(".tt-ind");
      if (!active || !ind) return;
      ind.style.width = `${active.offsetWidth}px`;
      ind.style.transform = `translateX(${active.offsetLeft}px)`;
    }

    private _render(): void {
      this.innerHTML = `<div class="tt-group" role="radiogroup" aria-label="Colour theme"><span class="tt-ind" aria-hidden="true"></span>${
        OPTIONS.map(opt => `<button class="tt-btn" role="radio" aria-checked="${opt === this._choice}" data-choice="${opt}" tabindex="${opt === this._choice ? 0 : -1}">${LABELS[opt]}</button>`).join("")
      }</div><span class="meta tt-caption" hidden></span>`;

      const group = this.querySelector(".tt-group")!;
      group.addEventListener("click", e => {
        const btn = (e.target as Element).closest<HTMLButtonElement>(".tt-btn");
        if (!btn) return;
        const choice = btn.dataset.choice as ThemeChoice;
        if (OPTIONS.includes(choice)) this._select(choice);
      });

      group.addEventListener("keydown", e => {
        const ke = e as KeyboardEvent;
        const btns = Array.from(this.querySelectorAll<HTMLButtonElement>(".tt-btn"));
        const idx = btns.findIndex(b => b === document.activeElement);
        if (idx === -1) return;
        if (ke.key === "ArrowRight" || ke.key === "ArrowDown") { ke.preventDefault(); btns[(idx + 1) % btns.length].focus(); }
        else if (ke.key === "ArrowLeft" || ke.key === "ArrowUp") { ke.preventDefault(); btns[(idx - 1 + btns.length) % btns.length].focus(); }
        else if (ke.key === "Enter" || ke.key === " ") {
          ke.preventDefault();
          const choice = btns[idx].dataset.choice as ThemeChoice;
          if (OPTIONS.includes(choice)) this._select(choice);
        }
      });
    }
  }

  if (!customElements.get("theme-toggle")) customElements.define("theme-toggle", ThemeToggle);
</script>
