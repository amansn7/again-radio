---
import Orb from "./Orb.astro";
const { ...attrs } = Astro.props;
---
<memory-card {...attrs}>
  <button class="mc-orb-btn" type="button" aria-label="Make the orb dance"><Orb class="mc-orb" /></button>
  <div class="mc-body">
    <div class="mc-skel" aria-hidden="true">
      <i class="skeleton"></i><i class="skeleton"></i><i class="skeleton"></i>
    </div>
    <p class="mc-text" aria-live="polite"></p>
  </div>
</memory-card>

<style is:global>
  /* The orb is the station's voice; the memory line is what it says, set as a transcript. */
  memory-card {
    order: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
  }
  memory-card .mc-orb { width: 4.75rem; }
  .mc-orb-btn {
    all: unset; position: relative; display: block; border-radius: 50%; cursor: pointer;
    transition: transform 400ms var(--ease-out), filter 400ms var(--ease-out);
  }
  .mc-orb-btn:hover { transform: scale(1.06); }
  .mc-orb-btn[data-near] { transform: translate(var(--near-x, 0), var(--near-y, 0)) scale(calc(1 + var(--near-strength, 0) * 0.09)); filter: drop-shadow(0 0 calc(0.35rem + var(--near-strength, 0) * 0.5rem) color-mix(in oklab, var(--accent) 55%, transparent)); }
  .mc-orb-btn::after {
    content: "click to spin"; position: absolute; left: 50%; top: calc(100% + 0.5rem); z-index: 1;
    padding: 0.2rem 0.5rem; border: 1px solid var(--line); border-radius: 999px;
    background: color-mix(in oklab, var(--bg-2) 88%, transparent); color: var(--fg-dim);
    font: 500 0.65rem/1.3 var(--font-body); white-space: nowrap; opacity: 0; pointer-events: none;
    transform: translate(-50%, -0.2rem); transition: opacity var(--dur-1), transform var(--dur-1) var(--ease-out);
  }
  .mc-orb-btn[data-hover]::after, .mc-orb-btn:focus-visible::after { opacity: 1; transform: translate(-50%, 0); }
  .mc-orb-btn:active { transform: scale(0.94); transition-duration: 120ms; }
  .mc-orb-btn:focus-visible { outline: 2px solid var(--fg); outline-offset: 6px; }
  .mc-orb-btn:has(radio-orb[data-wave]) { cursor: default; pointer-events: none; }
  .mc-orb-btn:has(radio-orb[data-wave])::after { display: none !important; }
  html.orb-feeding, html.orb-feeding * { cursor: none !important; }
  .orb-feed { position: fixed; inset: 0; z-index: 70; width: 100vw; height: 100vh; overflow: visible; pointer-events: none; opacity: 0; transition: opacity 140ms ease-out; }
  .orb-feed.is-active { opacity: var(--feed-strength, 0); }
  .orb-feed path { fill: none; stroke: var(--accent); stroke-width: calc(0.5px + var(--feed-strength, 0) * 1.6px); stroke-linecap: round; stroke-dasharray: 1 12; filter: drop-shadow(0 0 3px color-mix(in oklab, var(--accent) 82%, transparent)); animation: orb-feed-stream calc(850ms - var(--feed-strength, 0) * 600ms) linear infinite; }
  .orb-feed path:nth-child(2) { stroke: var(--orb-c1); stroke-dasharray: 1 17; animation-delay: -180ms; }
  .orb-feed path:nth-child(3) { stroke: var(--orb-c2); stroke-dasharray: 1 22; animation-delay: -360ms; }
  @keyframes orb-feed-stream { to { stroke-dashoffset: -26; } }
  .orb-feed-cursor { position: fixed; z-index: 71; left: 0; top: 0; width: 34px; height: 38px; opacity: 0; pointer-events: none; transform: translate3d(-50%, -50%, 0) rotate(var(--feed-angle, 0deg)) scale(1); transform-origin: 50% 50%; transition: opacity 140ms, scale 140ms var(--ease-out); }
  .orb-feed-cursor svg { display: block; width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 0 4px color-mix(in oklab, var(--accent) 82%, transparent)); }
  .orb-feed-cursor path { fill: var(--fg); stroke: color-mix(in oklab, var(--accent) 72%, var(--bg)); stroke-width: 1.2; stroke-linejoin: round; }
  .orb-feed-cursor.is-active { opacity: calc(0.88 - var(--feed-strength, 0) * 0.78); scale: calc(1 - var(--feed-strength, 0) * 0.72); }
  .disco-stage {
    position: fixed; top: 0; left: 0; z-index: 100;
    pointer-events: none;
  }

  .mc-text,
  .mc-skel {
    min-height: 3em;
    max-width: 34ch;
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    line-height: 1.5;
  }
  .mc-text {
    margin: 0;
    color: color-mix(in oklab, var(--fg) 92%, transparent);
    font-weight: 450;
    text-wrap: pretty;
    text-shadow:
      0 1px 2px color-mix(in oklab, var(--bg) 90%, transparent),
      0 0 18px color-mix(in oklab, var(--bg) 80%, transparent);
  }
  .mc-text.is-generated { color: color-mix(in oklab, var(--fg) 78%, transparent); }
  memory-card:not([data-ready]) .mc-text { display: none; }
  memory-card[data-ready] .mc-skel { display: none; }

  .mc-skel { display: flex; flex-direction: column; justify-content: center; gap: 0.5em; }
  .mc-skel i { height: 0.85em; }
  .mc-skel i:nth-child(1) { width: 96%; }
  .mc-skel i:nth-child(2) { width: 88%; }
  .mc-skel i:nth-child(3) { width: 54%; }

  .mc-text .mw {
    display: inline-block;
    animation: word-in 600ms var(--ease-out) both;
    animation-delay: calc(700ms + var(--i) * 55ms);
  }

  @media (max-width: 767px) {
    memory-card { gap: 1.1rem; align-items: start; }
    memory-card .mc-orb { width: 3.25rem; margin-top: 0.15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mc-text .mw { animation-delay: 0s !important; }
    .mc-orb-btn[data-near] { filter: none; transform: none; }
    .mc-orb-btn::after { transition: none; }
  }
</style>

<script>
  import "./memory-card.ts";
  const btn = document.querySelector<HTMLElement>(".mc-orb-btn");
  if (btn) {
    btn.addEventListener("click", () => {
      const orb = btn.querySelector<HTMLElement>("radio-orb");
      if (orb?.hasAttribute("data-wave")) return;
      import("./disco.ts").then((m) => m.disco(orb!));
    });
    const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const orb = btn.querySelector<HTMLElement>("radio-orb");
    let pointer: PointerEvent | null = null;
    let frame = 0;
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.classList.add("orb-feed");
    svg.setAttribute("aria-hidden", "true");
    const paths = [0, 1, 2].map(() => {
      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      svg.append(path);
      return path;
    });
    const cursor = document.createElement("span");
    cursor.className = "orb-feed-cursor";
    cursor.innerHTML = `<svg viewBox="0 0 32 38" aria-hidden="true"><path d="M13 20V6.5a2.7 2.7 0 0 1 5.4 0v11.2l1.1-3a2.2 2.2 0 0 1 4.2 1.3l-.4 2 1.1-1.5a2.1 2.1 0 0 1 3.8 1.7l-.7 2 1-1.1a2 2 0 0 1 3.4 2l-2 7a7.5 7.5 0 0 1-7.2 5.5h-3.5a7 7 0 0 1-5.4-2.6l-6-7.4a2.1 2.1 0 0 1 3.2-2.8L13 24z" transform="translate(-2 -2)" /></svg>`;
    document.body.append(svg, cursor);
    addEventListener("pointermove", (e) => {
      if (!finePointer.matches || reducedMotion.matches || e.pointerType !== "mouse") return;
      pointer = e;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (!pointer || !orb) return;
        if (orb.hasAttribute("data-wave")) {
          document.documentElement.classList.remove("orb-feeding");
          svg.classList.remove("is-active");
          cursor.classList.remove("is-active");
          btn.removeAttribute("data-near");
          btn.removeAttribute("data-hover");
          return;
        }
        const r = btn.getBoundingClientRect();
        const dx = pointer.clientX - (r.left + r.width / 2);
        const dy = pointer.clientY - (r.top + r.height / 2);
        const d = Math.hypot(dx, dy);
        const near = d < 154;
        const over = d < r.width * 0.56;
        const pull = Math.pow(Math.max(0, 1 - d / 154), 1.35);
        btn.toggleAttribute("data-near", near);
        btn.toggleAttribute("data-hover", over);
        if (near) {
          document.documentElement.classList.add("orb-feeding");
          svg.classList.add("is-active");
          cursor.classList.add("is-active");
          svg.style.setProperty("--feed-strength", pull.toFixed(3));
          cursor.style.setProperty("--feed-strength", pull.toFixed(3));
          cursor.style.left = `${pointer.clientX}px`;
          cursor.style.top = `${pointer.clientY}px`;
          const cx = r.left + r.width / 2;
          const cy = r.top + r.height / 2;
          const vx = cx - pointer.clientX;
          const vy = cy - pointer.clientY;
          cursor.style.setProperty("--feed-angle", `${(Math.atan2(vy, vx) * 180 / Math.PI + 90).toFixed(1)}deg`);
          const length = Math.max(d, 1);
          const nx = -vy / length;
          const ny = vx / length;
          paths.forEach((path, i) => {
            const offset = (i - 1) * (5 + pull * 13);
            const dPath = `M ${pointer.clientX} ${pointer.clientY} C ${pointer.clientX + vx * 0.32 + nx * offset} ${pointer.clientY + vy * 0.32 + ny * offset}, ${pointer.clientX + vx * 0.76 + nx * offset * 0.18} ${pointer.clientY + vy * 0.76 + ny * offset * 0.18}, ${cx} ${cy}`;
            path.setAttribute("d", dPath);
          });
          orb.style.setProperty("--orb-pull-x", `${Math.max(0, Math.min(100, 50 + dx / r.width * 100)).toFixed(1)}%`);
          orb.style.setProperty("--orb-pull-y", `${Math.max(0, Math.min(100, 50 + dy / r.height * 100)).toFixed(1)}%`);
          orb.style.setProperty("--orb-pull", pull.toFixed(3));
          orb.style.setProperty("--orb-pull-angle", `${(Math.atan2(dy, dx) * 180 / Math.PI).toFixed(1)}deg`);
          btn.style.setProperty("--near-strength", pull.toFixed(3));
          btn.style.setProperty("--near-x", `${(dx / Math.max(d, 1) * 4).toFixed(1)}px`);
          btn.style.setProperty("--near-y", `${(dy / Math.max(d, 1) * 4).toFixed(1)}px`);
        } else {
          document.documentElement.classList.remove("orb-feeding");
          svg.classList.remove("is-active");
          cursor.classList.remove("is-active");
          svg.style.removeProperty("--feed-strength");
          cursor.style.removeProperty("--feed-strength");
          ["--orb-pull-x", "--orb-pull-y", "--orb-pull", "--orb-pull-angle"].forEach((name) => orb.style.removeProperty(name));
          ["--near-x", "--near-y", "--near-strength"].forEach((name) => btn.style.removeProperty(name));
        }
      });
    }, { passive: true });
    reducedMotion.addEventListener("change", () => {
      if (reducedMotion.matches) {
        document.documentElement.classList.remove("orb-feeding");
        svg.classList.remove("is-active");
        cursor.classList.remove("is-active");
        btn.removeAttribute("data-near");
        btn.removeAttribute("data-hover");
        ["--orb-pull-x", "--orb-pull-y", "--orb-pull", "--orb-pull-angle"].forEach((name) => orb?.style.removeProperty(name));
        ["--near-x", "--near-y", "--near-strength"].forEach((name) => btn.style.removeProperty(name));
      }
    });
  }
</script>
