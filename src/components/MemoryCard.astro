---
import Orb from "./Orb.astro";
const { ...attrs } = Astro.props;
---
<memory-card {...attrs}>
  <button class="mc-orb-btn" type="button" aria-label="Make the orb dance"><Orb class="mc-orb" /></button>
  <div class="mc-body">
    <div class="mc-skel" aria-hidden="true">
      <i class="skeleton"></i><i class="skeleton"></i><i class="skeleton"></i>
    </div>
    <p class="mc-text" aria-live="polite"></p>
  </div>
</memory-card>

<style is:global>
  /* The orb is the station's voice; the memory line is what it says, set as a transcript. */
  memory-card {
    order: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
  }
  memory-card .mc-orb { width: 4.75rem; }
  .mc-orb-btn {
    all: unset; display: block; border-radius: 50%; cursor: pointer;
    transition: transform 400ms var(--ease-out);
  }
  .mc-orb-btn:hover { transform: scale(1.06); }
  .mc-orb-btn[data-near] { transform: translate(var(--near-x, 0), var(--near-y, 0)) scale(1.08); filter: drop-shadow(0 0 0.65rem color-mix(in oklab, var(--accent) 50%, transparent)); }
  .mc-orb-btn:active { transform: scale(0.94); transition-duration: 120ms; }
  .mc-orb-btn:focus-visible { outline: 2px solid var(--fg); outline-offset: 6px; }
  .disco-stage {
    position: fixed; top: 0; left: 0; z-index: 100;
    pointer-events: none;
  }

  .mc-text,
  .mc-skel {
    min-height: 3em;
    max-width: 34ch;
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    line-height: 1.5;
  }
  .mc-text {
    margin: 0;
    color: color-mix(in oklab, var(--fg) 92%, transparent);
    font-weight: 450;
    text-wrap: pretty;
    text-shadow:
      0 1px 2px color-mix(in oklab, var(--bg) 90%, transparent),
      0 0 18px color-mix(in oklab, var(--bg) 80%, transparent);
  }
  .mc-text.is-generated { color: color-mix(in oklab, var(--fg) 78%, transparent); }
  memory-card:not([data-ready]) .mc-text { display: none; }
  memory-card[data-ready] .mc-skel { display: none; }

  .mc-skel { display: flex; flex-direction: column; justify-content: center; gap: 0.5em; }
  .mc-skel i { height: 0.85em; }
  .mc-skel i:nth-child(1) { width: 96%; }
  .mc-skel i:nth-child(2) { width: 88%; }
  .mc-skel i:nth-child(3) { width: 54%; }

  .mc-text .mw {
    display: inline-block;
    animation: word-in 600ms var(--ease-out) both;
    animation-delay: calc(700ms + var(--i) * 55ms);
  }

  @media (max-width: 767px) {
    memory-card { gap: 1.1rem; align-items: start; }
    memory-card .mc-orb { width: 3.25rem; margin-top: 0.15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mc-text .mw { animation-delay: 0s !important; }
    .mc-orb-btn[data-near] { filter: none; transform: none; }
  }
</style>

<script>
  import "./memory-card.ts";
  const btn = document.querySelector<HTMLElement>(".mc-orb-btn");
  if (btn) {
    btn.addEventListener("click", () => import("./disco.ts").then((m) => m.disco(btn.querySelector("radio-orb")!)));
    const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    let near = false;
    addEventListener("pointermove", (e) => {
      if (!finePointer.matches || reducedMotion.matches || e.pointerType !== "mouse") return;
      const r = btn.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2);
      const dy = e.clientY - (r.top + r.height / 2);
      const d = Math.hypot(dx, dy);
      const next = near ? d < 112 : d < 76;
      if (next && d > 0) {
        btn.style.setProperty("--near-x", `${(dx / d * 4).toFixed(1)}px`);
        btn.style.setProperty("--near-y", `${(dy / d * 4).toFixed(1)}px`);
      } else if (!next) {
        btn.style.removeProperty("--near-x");
        btn.style.removeProperty("--near-y");
      }
      if (next === near) return;
      near = next;
      btn.toggleAttribute("data-near", near);
    }, { passive: true });
    reducedMotion.addEventListener("change", () => {
      if (reducedMotion.matches) { near = false; btn.removeAttribute("data-near"); }
    });
  }
</script>
