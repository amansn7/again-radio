---
---
<memory-card>
  <div class="mc-surface">
    <div class="mc-top-row">
      <span class="mc-label" id="mc-type-label">MEMORY</span>
      <span class="mc-person" id="mc-person" style="visibility:hidden"></span>
    </div>
    <div class="mc-body" id="mc-body">
      <p class="mc-caption" id="mc-caption"></p>
      <div class="mc-ident" id="mc-ident" style="visibility:hidden" aria-hidden="true">
        <span class="mc-ident-name">AGAIN RADIO</span>
        <span class="mc-ident-tagline">24 hours of a life in progress</span>
      </div>
    </div>
    <hr class="rule mc-rule" />
    <div class="mc-stamp-row">
      <span class="stamp" id="mc-stamp" style="visibility:hidden"></span>
    </div>
  </div>
</memory-card>

<style is:global>
  memory-card {
    display: block;
    width: 100%;
  }

  .mc-surface {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius, 3px);
    padding: 1.25rem 1.25rem 1rem;
    width: 100%;
    box-sizing: border-box;
  }

  .mc-top-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    min-height: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .mc-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .mc-person {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--card-fg);
    text-align: right;
  }

  .mc-body {
    min-height: 6rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .mc-caption {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--card-fg);
    margin: 0;
    transition: opacity 200ms ease;
  }

  .mc-caption.mc-generated {
    font-weight: 400;
    color: var(--fg-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .mc-caption {
      transition: none;
    }
  }

  .mc-ident {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.25rem;
  }

  .mc-ident-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--card-fg);
  }

  .mc-ident-tagline {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--fg-dim);
  }

  .mc-rule {
    margin-top: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .mc-stamp-row {
    min-height: 1.1rem;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }
</style>

<script>
  import "./memory-card.ts";
</script>
