---
const { ...attrs } = Astro.props;
---
<memory-card class="glass" {...attrs}>
  <div class="mc-wave" aria-hidden="true"></div>
  <div class="mc-skel" aria-hidden="true">
    <i class="skeleton"></i><i class="skeleton"></i><i class="skeleton"></i>
  </div>
  <p class="mc-text" aria-live="polite"></p>
</memory-card>

<style is:global>
  memory-card {
    order: 1;
    display: block;
    min-width: 0;
    max-width: 36rem;
    padding: 1.25rem 1.5rem 1.375rem;
  }

  .mc-text,
  .mc-skel {
    min-height: 4.5em;
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    line-height: 1.5;
    max-width: 38ch;
  }
  .mc-text { margin: 0; color: var(--fg); }
  .mc-text.is-generated { color: var(--fg-dim); }
  memory-card:not([data-ready]) .mc-text { display: none; }
  memory-card[data-ready] .mc-skel { display: none; }

  .mc-skel { display: flex; flex-direction: column; gap: 0.5em; padding-top: 0.2em; }
  .mc-skel i { height: 0.9em; }
  .mc-skel i:nth-child(1) { width: 96%; }
  .mc-skel i:nth-child(2) { width: 88%; }
  .mc-skel i:nth-child(3) { width: 54%; }

  .mc-text .mw {
    display: inline-block;
    animation: word-in 600ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 45ms);
  }


  /* Bars are scaled per frame by memory-card.ts on the track's beat grid. */
  .mc-wave {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 56px;
    margin-bottom: 1rem;
  }
  .mc-wave i {
    flex: 1 1 0;
    max-width: 6px;
    height: 100%;
    border-radius: 999px;
    background: color-mix(in oklab, var(--glass-light) 62%, transparent);
    transition: background-color var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease-out);
  }
  .mc-wave i.on {
    background: var(--accent);
    box-shadow: 0 0 10px color-mix(in oklab, var(--accent) 65%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .mc-text .mw { animation-delay: 0s !important; }
  }
</style>

<script>
  import "./memory-card.ts";
</script>
