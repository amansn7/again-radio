---
---
<radio-player data-playing="false" data-muted="true" data-live="true">
  <div class="rp-frame">
    <div class="rp-screen" inert>
      <div id="rp-yt"></div>
      <div class="rp-tuning skeleton"></div>
      <span class="stamp rp-stamp" aria-hidden="true"></span>
    </div>
  </div>

  <div class="rp-bar">
    <button class="btn-primary rp-tune" id="rp-tune" type="button" aria-label="Tune in with sound">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5zM16 9a4.5 4.5 0 010 6M18.5 6.5a8 8 0 010 11"/></svg>
      Tune in
    </button>
    <div class="rp-controls glass" data-glass>
      <button class="icon-btn" id="rp-play" type="button" aria-label="Pause">
        <svg class="rp-ico-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>
        <svg class="rp-ico-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l12 7-12 7z"/></svg>
      </button>
      <button class="icon-btn" id="rp-sound" type="button" aria-label="Unmute">
        <svg class="rp-ico-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5zM16 9a4.5 4.5 0 010 6M18.5 6.5a8 8 0 010 11"/></svg>
        <svg class="rp-ico-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5zM16 9.5l5 5M21 9.5l-5 5"/></svg>
      </button>
      <button class="icon-btn rp-shuffle" id="rp-shuffle" type="button" aria-label="Shuffle this set" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h3.5c2.5 0 4 1.5 5 5s2.5 5 5 5H20M4 17h3.5c1.3 0 2.3-.4 3-1.2M13.5 8.2c.7-.8 1.7-1.2 3-1.2H20M17 4l3 3-3 3M17 14l3 3-3 3"/></svg>
      </button>
      <button class="btn rp-back" id="rp-back" type="button">Back to live</button>
    </div>
    <details class="rp-keys">
      <summary class="icon-btn" aria-label="Keyboard shortcuts">?</summary>
      <p class="glass" data-glass>Space pauses, M mutes, arrows skip, Shift+L goes back to live</p>
    </details>
    <p class="meta rp-credit" aria-live="polite"></p>
    <p class="rp-error" role="alert" hidden>
      The video didn't load. YouTube may be blocked on this network. Reload to try again.
    </p>
  </div>
</radio-player>

<style is:global>
  radio-player {
    display: block;
  }

  /* The video is the page's backdrop: fixed to the viewport, cover-fit, behind the hero copy. */
  .rp-screen {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--bg);
  }

  /* Cover the viewport with the picture itself: --rp-a is the picture's aspect and --rp-fx/fy
     the share of the 16:9 embed it fills once YouTube's own black bars are discounted
     (measured from the thumbnail by player.ts). Bars are cropped away, the picture never stretched. */
  .rp-screen {
    --rp-a: 1.7778;
    --rp-fx: 1;
    --rp-fy: 1;
  }
  .rp-screen #rp-yt,
  .rp-screen iframe {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(max(100vw, 100lvh * var(--rp-a)) / var(--rp-fx));
    height: calc(max(100vw / var(--rp-a), 100lvh) / var(--rp-fy));
    transform: translate(-50%, -50%);
    border: 0;
  }

  /* YouTube's own error card never shows through; the ambient field stays the picture. */
  radio-player[data-novideo] .rp-screen iframe { visibility: hidden; }

  /* Wash toward the theme ground so the copy reads on any frame. */
  .rp-screen::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--bg) 72%, transparent),
      color-mix(in oklab, var(--bg) 55%, transparent) 55%,
      color-mix(in oklab, var(--bg) 50%, transparent)
    );
  }

  .rp-tuning {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }
  .rp-error {
    flex-basis: 100%;
    max-width: 52ch;
    margin: 0;
    padding-left: 0.875rem;
    border-left: 2px solid var(--accent);
    color: var(--fg);
    font-size: 0.9375rem;
    line-height: 1.5;
    text-shadow: 0 1px 10px var(--glass-drop);
  }
  .rp-error[hidden],
  .rp-tuning[hidden] {
    display: none;
  }

  .rp-stamp {
    position: absolute;
    right: 0.75rem;
    bottom: 0.6rem;
    pointer-events: none;
  }
  :root[data-theme="sleek"] .rp-stamp,
  .rp-stamp:empty {
    display: none;
  }

  .rp-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .rp-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding: 6px;
    border-radius: 999px;
  }
  radio-player[data-live="false"] .rp-controls { padding-right: 1.25rem; }
  .rp-credit {
    margin: 0 0 0 auto;
    text-align: right;
    text-shadow: 0 1px 10px var(--glass-drop);
  }
  .rp-keys { position: relative; }
  .rp-keys summary { list-style: none; width: 2rem; height: 2rem; font-size: 0.875rem; color: var(--fg-dim); }
  .rp-keys summary::-webkit-details-marker { display: none; }
  .rp-keys summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .rp-keys p {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    z-index: 2;
    width: max-content;
    max-width: 22rem;
    margin: 0;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius);
    font-size: 0.8125rem;
    color: var(--fg-dim);
  }
  @media not ((hover: hover) and (pointer: fine)) {
    .rp-keys { display: none; }
  }

  /* The one thing to do on arrival. Any click or key also turns sound on (player.ts);
     this is the target that says so. */
  .rp-tune {
    height: 3.5rem;
    padding: 0 1.75rem;
    font-size: 1.0625rem;
    font-weight: 600;
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 45%, transparent);
    animation: rp-tune 2.4s var(--ease-in-out) 1s infinite;
  }
  .rp-tune svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  @keyframes rp-tune { 50% { box-shadow: 0 0 28px 4px color-mix(in oklab, var(--accent) 45%, transparent); } }
  @media (prefers-reduced-motion: reduce) { .rp-tune { animation: none; } }

  /* Tune in (tune-in.ts): a ring of light leaves the tap and crosses the picture. */
  .rp-wave {
    position: absolute;
    z-index: 1;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(circle closest-side,
      transparent 62%,
      color-mix(in oklab, var(--accent) 55%, transparent) 86%,
      color-mix(in oklab, var(--accent) 20%, transparent) 94%,
      transparent);
    mix-blend-mode: screen;
    transform: scale(0.02);
    animation: rp-wave 1100ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes rp-wave {
    70% { opacity: 0.9; }
    to { transform: scale(1); opacity: 0; }
  }
  /* The button folds into the speaker; nothing else is captured, so the video keeps playing. */
  :root.rp-morphing { view-transition-name: none; }
  /* The shape that travels is the accent pill itself: its words leave first, the speaker
     arrives last, and the fill hands over to the glass button as it lands. */
  :root.rp-morphing .rp-controls { view-transition-name: rp-pill; }
  :root.rp-morphing .rp-keys { view-transition-name: rp-keys; }
  ::view-transition-group(rp-tune),
  ::view-transition-group(rp-pill),
  ::view-transition-group(rp-keys) { animation-duration: 560ms; animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
  ::view-transition-image-pair(rp-tune) {
    border-radius: 999px;
    background-color: var(--accent);
    animation: rp-land 560ms ease-in forwards;
  }
  ::view-transition-old(rp-tune) { animation: rp-fade 160ms ease-out reverse both; }
  ::view-transition-new(rp-tune) { animation: rp-fade 200ms ease-out 360ms both; }
  @keyframes rp-land { 55% { background-color: var(--accent); } to { background-color: transparent; } }
  @keyframes rp-fade { from { opacity: 0; } to { opacity: 1; } }
  @media (max-width: 639px) { .rp-tune { flex-basis: 100%; } }
  .rp-back { margin-left: 0.25rem; height: 2.5rem; }
  .rp-shuffle svg { fill: none; }
  .rp-shuffle[aria-pressed="true"] {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 70%, transparent);
  }
  .rp-shuffle:disabled { opacity: 0.4; cursor: default; }

  radio-player[data-live="true"] .rp-back {
    display: none;
  }

  radio-player[data-playing="true"] .rp-ico-play,
  radio-player[data-playing="false"] .rp-ico-pause,
  radio-player[data-muted="true"] .rp-ico-on,
  radio-player[data-muted="false"] .rp-ico-off {
    display: none;
  }

  .rp-ico-play {
    fill: currentColor;
  }

  .btn-primary:focus-visible,
  .btn:focus-visible,
  .icon-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .rp-credit {
      flex-basis: 100%;
      margin-left: 0;
      text-align: left;
    }
  }
</style>

<script>
  import "./player.ts";
  import "../lib/glass.ts";
</script>
