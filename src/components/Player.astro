---
---
<radio-player>
  <div class="rp-stage">
    <div class="rp-tuning" aria-live="polite">ON AIR · TUNING</div>
    <div class="rp-error" hidden>Unable to load player. Check your connection.</div>
    <div class="rp-frame-wrap" hidden>
      <div id="rp-yt"></div>
    </div>
  </div>
  <div class="rp-transport" aria-label="Playback controls">
    <button class="rp-btn" id="rp-play" aria-label="Play" disabled>PLAY</button>
    <button class="rp-btn" id="rp-sound" aria-label="Turn sound on" aria-pressed="false" disabled>SOUND OFF</button>
    <span class="rp-label" id="rp-prog-label" aria-live="polite"></span>
  </div>
</radio-player>

<style is:global>
  radio-player {
    display: block;
  }

  .rp-stage {
    position: relative;
    width: 100%;
    max-width: 960px;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    border-radius: var(--radius, 0);
    overflow: hidden;
    background: var(--bg-2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rp-tuning,
  .rp-error {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--fg-dim);
    text-transform: uppercase;
  }

  .rp-frame-wrap {
    position: absolute;
    inset: 0;
  }

  .rp-frame-wrap iframe,
  #rp-yt,
  #rp-yt iframe {
    width: 100% !important;
    height: 100% !important;
    border: none;
  }

  .rp-transport {
    max-width: 960px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .rp-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--fg);
    text-transform: uppercase;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius, 0);
  }

  .rp-btn:disabled {
    color: var(--fg-dim);
    cursor: default;
  }

  .rp-btn:not(:disabled):hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .rp-label {
    color: var(--fg-dim);
    text-transform: uppercase;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }
</style>

<script>
  import "./player.ts";
</script>
