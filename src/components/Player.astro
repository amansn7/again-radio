---
---
<radio-player data-playing="false" data-muted="true" data-live="true">
  <div class="rp-frame">
    <div class="rp-screen" inert>
      <div id="rp-yt"></div>
      <div class="rp-tuning skeleton"></div>
      <span class="stamp rp-stamp" aria-hidden="true"></span>
    </div>
  </div>

  <div class="rp-bar">
    <section class="rp-rory-panel glass" id="rp-rory-panel" aria-labelledby="rp-rory-title" hidden>
      <p class="rp-rory-quote" hidden></p>
      <h2 class="rp-rory-title" id="rp-rory-title">That's Rory, your host between songs.</h2>
      <fieldset class="rp-rory-kinds">
        <legend>What Rory does</legend>
        <label><input type="checkbox" value="welcome" checked /><span>Says hello</span></label>
        <label><input type="checkbox" value="intros" checked /><span>Introduces songs</span></label>
        <label><input type="checkbox" value="outros" checked /><span>Names what just played</span></label>
        <label><input type="checkbox" value="thoughts" checked /><span>Shares thoughts mid-song</span></label>
        <label><input type="checkbox" value="fillers" checked /><span>Gives shout-outs and facts</span></label>
      </fieldset>
      <p class="rp-rory-hint">Change this any time with the mic button.</p>
      <div class="rp-rory-actions">
        <button class="btn-primary rp-rory-done" type="button">Keep Rory</button>
        <button class="btn rp-rory-all" type="button">Clear all</button>
      </div>
    </section>
    <button class="btn-primary rp-tune" id="rp-tune" type="button" aria-label="Tune in with sound">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5zM16 9a4.5 4.5 0 010 6M18.5 6.5a8 8 0 010 11"/></svg>
      Tune in
    </button>
    <div class="rp-controls glass" data-glass>
      <button class="icon-btn" id="rp-play" type="button" aria-label="Pause">
        <svg class="rp-ico-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>
        <svg class="rp-ico-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l12 7-12 7z"/></svg>
      </button>
      <button class="icon-btn" id="rp-sound" type="button" aria-label="Unmute">
        <svg class="rp-ico-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5zM16 9a4.5 4.5 0 010 6M18.5 6.5a8 8 0 010 11"/></svg>
        <svg class="rp-ico-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5zM16 9.5l5 5M21 9.5l-5 5"/></svg>
      </button>
      <button class="icon-btn rp-rory" id="rp-rory" type="button" aria-label="Rory, the host: on" aria-expanded="false" aria-controls="rp-rory-panel" data-on="true">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5a2.75 2.75 0 012.75 2.75v5a2.75 2.75 0 01-5.5 0v-5A2.75 2.75 0 0112 3.5zM6.5 11a5.5 5.5 0 0011 0M12 16.5v4"/><path class="rp-rory-off" d="M4.5 4.5l15 15"/></svg>
      </button>
      <button class="icon-btn rp-shuffle" id="rp-shuffle" type="button" aria-label="Shuffle this set" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h3.5c2.5 0 4 1.5 5 5s2.5 5 5 5H20M4 17h3.5c1.3 0 2.3-.4 3-1.2M13.5 8.2c.7-.8 1.7-1.2 3-1.2H20M17 4l3 3-3 3M17 14l3 3-3 3"/></svg>
      </button>
      <button class="icon-btn rp-share" id="rp-share" type="button" aria-label="Share this moment">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M8 8l4-4 4 4M6 12v6.5h12V12"/></svg>
      </button>
      <button class="btn rp-back" id="rp-back" type="button">Back to live</button>
    </div>
    <details class="rp-keys">
      <summary class="icon-btn" aria-label="Keyboard shortcuts">?</summary>
      <p class="glass" data-glass>Space pauses, M mutes, arrows skip, Shift+L goes back to live</p>
    </details>
    <p class="meta rp-credit" aria-live="polite"><a class="rp-credit-link" target="_blank" rel="noreferrer" title="Watch broadcast on official YouTube channel"></a></p>
    <p class="rp-toast glass" data-glass role="status" hidden></p>
    <p class="rp-error" role="alert" hidden>
      The video didn't load. YouTube may be blocked on this network. Reload to try again.
    </p>
  </div>
</radio-player>

<style is:global>
  radio-player {
    display: block;
  }

  /* The video is the page's backdrop: fixed to the viewport, cover-fit, behind the hero copy. */
  .rp-screen {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--bg);
  }

  /* Cover the viewport with the picture itself: --rp-a is the picture's aspect and --rp-fx/fy
     the share of the 16:9 embed it fills once YouTube's own black bars are discounted
     (measured from the thumbnail by player.ts). Bars are cropped away, the picture never stretched. */
  .rp-screen {
    --rp-a: 1.7778;
    --rp-fx: 1;
    --rp-fy: 1;
  }
  .rp-screen #rp-yt,
  .rp-screen iframe {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(max(100vw, 100lvh * var(--rp-a)) / var(--rp-fx));
    height: calc(max(100vw / var(--rp-a), 100lvh) / var(--rp-fy));
    transform: translate(-50%, -50%);
    border: 0;
  }

  /* YouTube's own error card never shows through; the ambient field stays the picture. */
  radio-player[data-novideo] .rp-screen iframe { visibility: hidden; }

  /* Wash toward the theme ground so the copy reads on any frame. */
  .rp-screen::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--bg) var(--scrim-bottom, 78%), transparent),
      color-mix(in oklab, var(--bg) var(--scrim-mid, 65%), transparent) 55%,
      color-mix(in oklab, var(--bg) var(--scrim-top, 52%), transparent)
    );
  }

  .rp-tuning {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }
  .rp-error {
    flex-basis: 100%;
    max-width: 52ch;
    margin: 0;
    padding-left: 0.875rem;
    border-left: 2px solid var(--accent);
    color: var(--fg);
    font-size: 0.9375rem;
    line-height: 1.5;
    text-shadow: 0 1px 10px var(--glass-drop);
  }
  .rp-error[hidden],
  .rp-tuning[hidden] {
    display: none;
  }

  .rp-stamp {
    position: absolute;
    right: 0.75rem;
    bottom: 0.6rem;
    pointer-events: none;
  }
  :root[data-theme="sleek"] .rp-stamp,
  .rp-stamp:empty {
    display: none;
  }

  .rp-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .rp-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding: 6px;
    border-radius: 999px;
  }
  radio-player[data-live="false"] .rp-controls { padding-right: 1.25rem; }
  .rp-credit {
    margin: 0 0 0 auto;
    text-align: right;
    text-shadow: 0 1px 10px var(--glass-drop);
  }
  .rp-credit-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-1), opacity var(--dur-1);
    opacity: 0.85;
  }
  .rp-credit-link:hover,
  .rp-credit-link:focus-visible {
    opacity: 1;
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rp-keys { position: relative; }
  .rp-keys summary { list-style: none; width: 2rem; height: 2rem; font-size: 0.875rem; color: var(--fg-dim); }
  .rp-keys summary::-webkit-details-marker { display: none; }
  .rp-keys summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .rp-keys p {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    z-index: 2;
    width: max-content;
    max-width: 22rem;
    margin: 0;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius);
    font-size: 0.8125rem;
    color: var(--fg-dim);
  }
  @media not ((hover: hover) and (pointer: fine)) {
    .rp-keys { display: none; }
  }

  /* The one thing to do on arrival. Any click or key also turns sound on (player.ts);
     this is the target that says so. */
  .rp-tune {
    height: 3.5rem;
    padding: 0 1.75rem;
    font-size: 1.0625rem;
    font-weight: 600;
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 45%, transparent);
    animation: rp-tune 2.4s var(--ease-in-out) 1s infinite;
  }
  .rp-tune svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  @keyframes rp-tune { 50% { box-shadow: 0 0 28px 4px color-mix(in oklab, var(--accent) 45%, transparent); } }
  @media (prefers-reduced-motion: reduce) { .rp-tune { animation: none; } }

  /* Tune in (tune-in.ts): a ring of light leaves the tap and crosses the picture. */
  .rp-wave {
    position: absolute;
    z-index: 1;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(circle closest-side,
      transparent 62%,
      color-mix(in oklab, var(--accent) 55%, transparent) 86%,
      color-mix(in oklab, var(--accent) 20%, transparent) 94%,
      transparent);
    mix-blend-mode: screen;
    transform: scale(0.02);
    animation: rp-wave 1100ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes rp-wave {
    70% { opacity: 0.9; }
    to { transform: scale(1); opacity: 0; }
  }
  /* The button folds into the speaker; nothing else is captured, so the video keeps playing. */
  :root.rp-morphing { view-transition-name: none; }
  /* The shape that travels is the accent pill itself: its words leave first, the speaker
     arrives last, and the fill hands over to the glass button as it lands. */
  :root.rp-morphing .rp-controls { view-transition-name: rp-pill; }
  :root.rp-morphing .rp-keys { view-transition-name: rp-keys; }
  ::view-transition-group(rp-tune),
  ::view-transition-group(rp-pill),
  ::view-transition-group(rp-keys) { animation-duration: 560ms; animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
  ::view-transition-image-pair(rp-tune) {
    border-radius: 999px;
    background-color: var(--accent);
    animation: rp-land 560ms ease-in forwards;
  }
  ::view-transition-old(rp-tune) { animation: rp-fade 160ms ease-out reverse both; }
  ::view-transition-new(rp-tune) { animation: rp-fade 200ms ease-out 360ms both; }
  @keyframes rp-land { 55% { background-color: var(--accent); } to { background-color: transparent; } }
  @keyframes rp-fade { from { opacity: 0; } to { opacity: 1; } }
  @media (max-width: 639px) { .rp-tune { flex-basis: 100%; } }
  .rp-back { margin-left: 0.25rem; height: 2.5rem; }
  .rp-shuffle svg, .rp-share svg, .rp-rory svg { fill: none; }
  .rp-rory[data-on="true"] {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 70%, transparent);
  }
  .rp-rory[data-on="true"] .rp-rory-off { display: none; }
  .rp-rory[data-on="false"] { color: var(--fg-dim); }
  .rp-rory[aria-expanded="true"] { background: color-mix(in oklab, var(--fg) 14%, transparent); }

  /* Rory's settings. Opens by itself once, after the first welcome (the line just heard is the
     example), then from the mic button. Sits over the page so nothing below it moves. */
  .rp-bar { position: relative; }
  .rp-rory-panel {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.75rem);
    z-index: 4;
    width: min(23rem, 100%);
    margin: 0;
    padding: 1.125rem 1.125rem 1rem;
    border-radius: calc(var(--radius) * 1.6);
    animation: rp-rise var(--dur-2) var(--ease-out);
  }
  /* Denser than the controls' clear glass: this one is read, over a busy picture. */
  .rp-bar .rp-rory-panel.glass {
    background: color-mix(in oklab, var(--bg-2) 80%, transparent);
    -webkit-backdrop-filter: blur(28px) saturate(1.4);
    backdrop-filter: blur(28px) saturate(1.4);
  }
  .rp-rory-panel[hidden] { display: none; }
  .rp-rory-panel p { margin: 0; }
  .rp-rory-quote {
    margin-bottom: 0.5rem !important;
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--fg);
    text-wrap: balance;
  }
  .rp-rory-title {
    margin: 0;
    font: 600 1rem/1.35 var(--font-body);
    color: var(--fg);
  }
  .rp-rory-quote:not([hidden]) + .rp-rory-title { font-weight: 400; font-size: 0.9375rem; color: color-mix(in oklab, var(--fg) 80%, transparent); }
  .rp-rory-kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.875rem 0 0;
    padding: 0;
    border: 0;
  }
  .rp-rory-kinds legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .rp-rory-kinds label { position: relative; display: inline-flex; cursor: pointer; }
  .rp-rory-kinds input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .rp-rory-kinds span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0 0.875rem 0 0.75rem;
    border: 1px solid color-mix(in oklab, var(--fg) 24%, transparent);
    border-radius: 999px;
    font-size: 0.875rem;
    color: color-mix(in oklab, var(--fg) 72%, transparent);
    transition: color var(--dur-1, 160ms) ease, background-color var(--dur-1, 160ms) ease, border-color var(--dur-1, 160ms) ease;
  }
  /* The tick is drawn, so an unticked chip keeps its width. */
  .rp-rory-kinds span::before {
    content: "";
    width: 0.75rem;
    height: 0.4rem;
    margin-top: -0.2rem;
    border: solid currentColor;
    border-width: 0 0 2px 2px;
    transform: rotate(-45deg) scale(0.6);
    opacity: 0;
    transition: opacity var(--dur-1, 160ms) ease, transform var(--dur-1, 160ms) ease;
  }
  .rp-rory-kinds input:checked + span {
    color: var(--fg);
    background: color-mix(in oklab, var(--accent) 22%, transparent);
    border-color: color-mix(in oklab, var(--accent) 70%, transparent);
  }
  .rp-rory-kinds input:checked + span::before { opacity: 1; transform: rotate(-45deg) scale(1); }
  .rp-rory-kinds label:hover span { border-color: color-mix(in oklab, var(--fg) 35%, transparent); }
  .rp-rory-kinds input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .rp-rory-hint { margin-top: 0.75rem !important; font-size: 0.8125rem; color: color-mix(in oklab, var(--fg) 66%, transparent); }
  .rp-rory-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.875rem; }
  @media (max-width: 767px) {
    .rp-rory-kinds span { min-height: 44px; }
  }
  @keyframes rp-rise { from { opacity: 0; transform: translateY(0.5rem); } }
  @media (prefers-reduced-motion: reduce) {
    .rp-rory-panel { animation: none; }
    .rp-rory-kinds span, .rp-rory-kinds span::before { transition: none; }
  }
  ::view-transition-group(rp-rory) { animation-duration: 440ms; animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
  ::view-transition-old(rp-rory) { animation: rp-fade 160ms ease-out reverse both; }
  ::view-transition-new(rp-rory) { animation: rp-fade 200ms ease-out 240ms both; }
  .rp-toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    z-index: 5;
    margin: 0;
    padding: 0.625rem 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--fg);
    transform: translateX(-50%);
    animation: rp-toast var(--dur-2) var(--ease-out);
  }
  .rp-toast[hidden] { display: none; }
  @keyframes rp-toast { from { opacity: 0; transform: translate(-50%, 0.5rem); } }
  @media (prefers-reduced-motion: reduce) { .rp-toast { animation: none; } }
  .rp-shuffle[aria-pressed="true"] {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 70%, transparent);
  }
  .rp-shuffle:disabled { opacity: 0.4; cursor: default; }

  radio-player[data-live="true"] .rp-back {
    display: none;
  }

  radio-player[data-playing="true"] .rp-ico-play,
  radio-player[data-playing="false"] .rp-ico-pause,
  radio-player[data-muted="true"] .rp-ico-on,
  radio-player[data-muted="false"] .rp-ico-off {
    display: none;
  }

  .rp-ico-play {
    fill: currentColor;
  }

  .btn-primary:focus-visible,
  .btn:focus-visible,
  .icon-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .rp-credit {
      flex-basis: 100%;
      margin-left: 0;
      text-align: left;
    }
  }
</style>

<script>
  import "./player.ts";
  import "./share-button.ts";
  import "../lib/glass.ts";
</script>
