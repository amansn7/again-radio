---
---

<section class="wrap ro-section" aria-labelledby="ro-title">
  <running-order {...Astro.props}></running-order>
</section>

<style is:global>
  .ro-section { padding-block: clamp(4rem, 8vw, 7rem) 0; }
  running-order { display: block; }
  .ro-head { display: grid; gap: 0.5rem; margin-bottom: 2rem; }
  .ro-tabs { display: flex; gap: 0.25rem 1.75rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .ro-tab {
    background: none; border: 0; padding: 0.35rem 0; cursor: pointer;
    font: 500 1rem/1.3 var(--font-body); color: var(--fg-faint);
    border-bottom: 1px solid transparent;
    transition: color var(--dur-2) var(--ease-out), border-color var(--dur-2) var(--ease-out), transform var(--dur-1) var(--ease-out);
  }
  .ro-tab:hover { color: var(--fg); }
  .ro-tab:active { transform: scale(0.97); }
  .ro-tab[aria-selected="true"] { color: var(--fg); border-bottom-color: var(--accent); }
  .ro-tab:focus-visible, .ro-row:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ro-info { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; min-height: 2.5rem; }

  .ro-list { list-style: none; margin: 0; padding: 0; max-width: 62rem; }
  .ro-row {
    position: relative; display: grid; grid-template-columns: 4.5rem 1fr; column-gap: 1rem;
    width: 100%; text-align: left; background: none; border: 0; color: inherit; cursor: pointer;
    font: inherit; padding: 1.1rem 0.75rem; border-radius: var(--radius);
    transition: background-color var(--dur-1) var(--ease-out);
  }
  .ro-row:hover { background: color-mix(in oklab, var(--fg) 4%, transparent); }
  .ro-time { color: var(--fg-faint); font-size: 0.875rem; padding-top: 0.45rem; }
  .ro-main { display: grid; gap: 0.15rem; min-width: 0; }
  .ro-title { font-size: 1rem; line-height: 1.35; color: var(--fg-dim); }
  .ro-name {
    display: inline-block; color: var(--fg);
    font-family: var(--font-name); font-weight: var(--name-weight); letter-spacing: var(--name-tracking);
    font-size: clamp(1.375rem, 2vw, 1.75rem); line-height: 1.15;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .ro-row:hover .ro-name { transform: translateX(4px); }
  .ro-mem { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ro-live { display: none; align-items: center; gap: 0.5rem; margin-bottom: 0.3rem; }
  .ro-row.is-live .ro-live { display: flex; }
  .ro-bar {
    position: absolute; left: 5.5rem; right: 0.75rem; bottom: 0; height: 2px;
    background: var(--accent); transform: scaleX(0); transform-origin: left; opacity: 0;
  }
  .ro-row.is-live .ro-bar { opacity: 1; }

  :root[data-theme="diary"] .ro-row { border-radius: 0; border-bottom: 1px solid var(--line); }
  :root[data-theme="diary"] .ro-name { font-style: normal; }
  :root[data-theme="sleek"] .ro-row.is-live { background: color-mix(in oklab, var(--accent) 8%, transparent); }

  .ro-skel { height: 4.25rem; margin-bottom: 0.5rem; max-width: 62rem; }
  .ro-error { max-width: 36rem; }

  @media (max-width: 767px) {
    .ro-row { grid-template-columns: 3.5rem 1fr; padding-inline: 0.25rem; }
    .ro-bar { left: 4.5rem; right: 0.25rem; }
  }
</style>

<script>
  import "./running-order.ts";
</script>
